# Copy to .env for local runs (npm run start:dev). In Kubernetes these come from a ConfigMap/Secret.
NODE_ENV=development
PORT=3000
APP_ENV=local
APP_NAME=nestjs-backend
APP_VERSION=1.0.0
GREETING_MESSAGE=Hello from NestJS running locally
FEATURE_FLAGS=beta-items,verbose-info
LOG_LEVEL=debug
# Milliseconds the app pretends to "warm up" before reporting started/ready (demonstrates startup probes)
STARTUP_DELAY_MS=3000
# Enables POST /demo/unready and POST /demo/crash (never true in prod)
DEMO_ENDPOINTS_ENABLED=true
# Optional. When set, /api/* requires header  x-api-key: <value>
# API_KEY=change-me
